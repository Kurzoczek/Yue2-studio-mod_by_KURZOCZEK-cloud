diff --git a/scripts/patch-engine-threads.sh b/scripts/patch-engine-threads.sh
new file mode 100755
index 0000000..e92d176
--- /dev/null
+++ b/scripts/patch-engine-threads.sh
@@ -0,0 +1,41 @@
+#!/bin/bash
+# Poprawka liczby wątków silnika (acestep.cpp / yue2.cpp, plik src/backend.h).
+# Oryginał liczy na połowie rdzeni ("hyperthreading"), co na procesorach bez HT (np. Intel N150: 4 rdzenie,
+# 4 wątki) daje tylko 2 wątki. Po poprawce:
+#   STUDIO_CPU_THREADS=N  -> dokładnie N wątków (ustawia to studio: Ustawienia -> Procesor -> Wątki),
+#   brak zmiennej         -> wszystkie rdzenie.
+# Użycie: patch-engine-threads.sh <katalog źródeł silnika>
+set -euo pipefail
+src="${1:?użycie: patch-engine-threads.sh KATALOG_ŹRÓDEŁ}"
+header="$src/src/backend.h"
+if [ ! -f "$header" ]; then
+    echo "[UWAGA] $header nie istnieje - poprawka wątków pominięta (silnik użyje połowy rdzeni)" >&2
+    exit 0
+fi
+if grep -q 'studio_cpu_threads' "$header"; then
+    echo "[OK] poprawka wątków już jest w $header"
+    exit 0
+fi
+if ! grep -q 'std::thread::hardware_concurrency() / 2' "$header"; then
+    echo "[UWAGA] w $header nie ma wyrażenia 'hardware_concurrency() / 2' - poprawka wątków pominięta" >&2
+    exit 0
+fi
+tmp="$(mktemp)"
+cat > "$tmp" <<'EOT'
+// --- studio: liczba wątków procesora (STUDIO_CPU_THREADS, domyślnie wszystkie rdzenie) ---
+#ifndef STUDIO_CPU_THREADS_DEFINED
+#define STUDIO_CPU_THREADS_DEFINED
+#include <cstdlib>
+#include <thread>
+static inline unsigned studio_cpu_threads() {
+    const char * e = std::getenv("STUDIO_CPU_THREADS");
+    int n = e ? std::atoi(e) : 0;
+    if (n > 0) return (unsigned) n;
+    unsigned h = std::thread::hardware_concurrency();
+    return h > 0 ? h : 1;
+}
+#endif
+EOT
+sed 's#std::thread::hardware_concurrency() / 2#studio_cpu_threads()#' "$header" >> "$tmp"
+mv "$tmp" "$header"
+echo "[OK] poprawka wątków w $header (STUDIO_CPU_THREADS)"
diff --git a/scripts/yue2-studio-debian b/scripts/yue2-studio-debian
new file mode 100755
index 0000000..86ed7a1
--- /dev/null
+++ b/scripts/yue2-studio-debian
@@ -0,0 +1,42 @@
+#!/bin/sh
+# Program uruchamiający YuE2 Studio na Debianie (instalowany jako /usr/local/bin/yue2-studio):
+#  - odmawia pracy jako root (studio zapisuje pliki i uruchamia programy na polecenie swojego API),
+#  - wyłącza telemetrię (DO_NOT_TRACK),
+#  - trzyma dane i modele (kilka-kilkanaście GB) na dysku iSCSI, nie na małym /,
+#  - kieruje silnik na zintegrowany GPU Intel, a nie na programowy llvmpipe.
+# Limity procesora, RAM-u, rdzeni, priorytetu i ochronę przed przegrzaniem ustawia się w studiu:
+# Ustawienia -> Pamięć / Procesor (silnik YuE2 dostaje je przy każdym starcie).
+
+if [ "$(id -u)" -eq 0 ]; then
+  echo "YuE2 Studio nie powinno działać jako root. Uruchom je jako zwykły użytkownik (np. lukasz)." >&2
+  exit 1
+fi
+
+DATA="${YUE_STUDIO_DATA_ROOT:-/mnt/iscsi/Modele_ai/yue2-studio}"
+case "$DATA" in
+  /mnt/iscsi/*)
+    if ! mountpoint -q /mnt/iscsi; then
+      msg="Dysk iSCSI (/mnt/iscsi) nie jest zamontowany, a na nim są dane i modele YuE2 Studio."
+      command -v kdialog >/dev/null 2>&1 && kdialog --error "$msg" 2>/dev/null
+      echo "$msg" >&2
+      exit 1
+    fi ;;
+esac
+mkdir -p "$DATA" || exit 1
+
+export YUE_STUDIO_DATA_ROOT="$DATA"
+
+# yue2-studio --klucz : klucz lokalnego API (dla agentów, np. Claude Code); powstaje przy pierwszym starcie studia
+if [ "${1:-}" = "--klucz" ]; then
+  if [ -r "$DATA/local-api-key" ]; then cat "$DATA/local-api-key"; echo; exit 0; fi
+  echo "Klucza jeszcze nie ma — uruchom studio raz, potem powtórz." >&2; exit 1
+fi
+export DO_NOT_TRACK=1
+export GGML_VK_VISIBLE_DEVICES="${GGML_VK_VISIBLE_DEVICES:-0}"
+# Gdyby okno było puste/czarne (znany problem WebKitGTK z niektórymi sterownikami), odkomentuj:
+# export WEBKIT_DISABLE_DMABUF_RENDERER=1
+
+BIN=/usr/bin/YuE2-Studio
+[ -x "$BIN" ] || BIN="$(command -v YuE2-Studio || command -v yue2-studio-bin || true)"
+[ -n "$BIN" ] || { echo "Nie znalazłem programu YuE2-Studio — czy paczka .deb jest zainstalowana?" >&2; exit 1; }
+exec "$BIN" "$@"
